{
  "expo": {
    "name": "Sawab",
    "slug": "sawab",
    "version": "1.0.0",
    "scheme": "sawab",
    "icon": "./assets/sawabicon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/sawabicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "4a1f6981-db50-4271-87c8-3e6fb651b48d"
      }
    },
    "android": {
      "package": "com.sawab.app",
      "googleServicesFile": "./google-services.json"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a1f6981-db50-4271-87c8-3e6fb651b48d"
    },
    "ios": {}
  }
}
